{
  "name": "@durable-systems/state",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "npm run build",
    "verify": "npm run check && npm test",
    "prepack": "npm run verify",
    "verify:implementations": "npm test",
    "verify:install": "node scripts/verify-install.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./node-sqlite": {
      "types": "./dist/src/adapters/node-sqlite.d.ts",
      "import": "./dist/src/adapters/node-sqlite.js"
    },
    "./stdio-protocol": {
      "types": "./dist/src/stdio-protocol.d.ts",
      "import": "./dist/src/stdio-protocol.js"
    }
  },
  "bin": {
    "state-stdio": "./dist/src/stdio.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "effect": "3.22.2",
    "typescript": "5.9.3"
  },
  "description": "Domain-neutral content-addressed state persistence, integrity, history, and recovery",
  "peerDependencies": {
    "effect": "3.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameelsalami/state.git"
  },
  "homepage": "https://github.com/jameelsalami/state#readme",
  "bugs": {
    "url": "https://github.com/jameelsalami/state/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
